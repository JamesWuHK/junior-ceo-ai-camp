NODE_ENV=production
PORT=7001
HOST=0.0.0.0
CORS_ORIGIN=https://camps.wanli.wiki
AUTH_SECRET=change-me-long-random-auth-secret
AUTH_TOKEN_EXPIRES_SECONDS=43200
TEACHER_SEED_USERNAME=teacher
TEACHER_SEED_PASSWORD=change-me-before-class
TEACHER_SEED_DISPLAY_NAME=主讲老师
DATABASE_PATH=/app/data/camp.db
PUBLIC_API_BASE=https://api.camps.wanli.wiki
LOCAL_UPLOAD_ENABLED=false
LOCAL_UPLOAD_DIR=/app/uploads

# Optional Tencent COS signing. If these are empty, upload-token returns a mock key
# so the classroom workflow can still be tested. In development you may set
# LOCAL_UPLOAD_ENABLED=true to save uploaded photos to LOCAL_UPLOAD_DIR.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_UPLOAD_PREFIX=ceo-camp
COS_UPLOAD_EXPIRES_SECONDS=900
